<Project>
  <PropertyGroup>
    <CopilotCliBinaryPath Condition="'$(CopilotCliBinaryPath)' == '' And '$(COPILOT_CLI_BINARY_PATH)' != ''">$(COPILOT_CLI_BINARY_PATH)</CopilotCliBinaryPath>
    <CopilotCliBinaryPath Condition="'$(CopilotCliBinaryPath)' == '' And '$(OS)' == 'Windows_NT' And Exists('$(LOCALAPPDATA)\Microsoft\WinGet\Links\copilot.exe')">$(LOCALAPPDATA)\Microsoft\WinGet\Links\copilot.exe</CopilotCliBinaryPath>
    <CopilotCliBinaryPath Condition="'$(CopilotCliBinaryPath)' == '' And Exists('/opt/homebrew/bin/copilot')">/opt/homebrew/bin/copilot</CopilotCliBinaryPath>
    <CopilotCliBinaryPath Condition="'$(CopilotCliBinaryPath)' == '' And Exists('/usr/local/bin/copilot')">/usr/local/bin/copilot</CopilotCliBinaryPath>
  </PropertyGroup>
</Project>